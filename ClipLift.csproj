<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ClipLift</RootNamespace>
    <AssemblyName>ClipLift</AssemblyName>
    <!-- 64-bit process so that System32\OpenSSH is not hidden by WOW64 redirection -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ClipLift.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>ClipLift</Product>
    <Description>Upload clipboard images to an SSH server from the tray</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- Build-time helper with its own project; see tools/IconGen -->
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

</Project>
